<Application
    x:Class="LanMessenger.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- XamlControlsResources first, so everything after it can
                 override Fluent defaults. Styles/Glass.xaml merges the
                 generated Styles/GlassTokens.xaml itself, so its styles can
                 StaticResource the tokens; the Token*Brush, Token*Color and
                 Glass*Brush resources reach the whole app through it.

                 There is no hand-written palette here any more. Every colour
                 comes from design/liquid-glass/tokens.json through
                 scripts/design/gen_tokens.py, and the brand green is fixed
                 (TokenBrandBrush) rather than the user's OS accent: overriding
                 SystemAccentColor app-wide is unreliable in WinAppSDK
                 (microsoft-ui-xaml#6394), so every spot that would read
                 AccentFillColorDefaultBrush / AccentButtonStyle points at a
                 token or a Glass*ButtonStyle directly. -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Glass.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
