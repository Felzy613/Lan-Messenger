<UserControl
    x:Class="LanMessenger.UI.AvatarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fills whatever size the host gives it (size-avatar-row 44 in the
         sidebar, size-avatar-header 36 in the chat header); the initials scale
         with it in SizeChanged. It used to draw a fixed 40px disc whatever it
         was asked for. -->
    <Grid x:Name="RootGrid">
        <Ellipse x:Name="BackgroundEllipse" />
        <Ellipse x:Name="PhotoEllipse" Visibility="Collapsed">
            <Ellipse.Fill>
                <ImageBrush x:Name="PhotoBrush" Stretch="UniformToFill" />
            </Ellipse.Fill>
        </Ellipse>
        <TextBlock x:Name="InitialsText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource TokenInkInverseBrush}" />
    </Grid>
</UserControl>
