<UserControl
    x:Class="LanMessenger.UI.TypingIndicatorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shell is an invisible wrapper by default so the header and the sidebar
         row get bare dots; UseBubbleShell() turns it into an incoming message
         bubble for the copy that sits at the end of the thread.

         Dot geometry, colour and spacing are set from code-behind
         (DotDiameter / DotSpacing / DotBrush) — the starting Opacity and Scale
         below match the low end of the pulse so the first frame drawn is the
         same one the animation would draw. -->
    <Border x:Name="Shell"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            BorderBrush="{ThemeResource GlassRimBrush}"
            BorderThickness="0">
        <StackPanel x:Name="DotRow" Orientation="Horizontal" Spacing="5">
            <Ellipse x:Name="Dot1" Width="8" Height="8" Opacity="0.38"
                     Fill="{ThemeResource TokenInkSecondaryBrush}"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="Dot1Scale" ScaleX="0.82" ScaleY="0.82" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Dot2" Width="8" Height="8" Opacity="0.38"
                     Fill="{ThemeResource TokenInkSecondaryBrush}"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="Dot2Scale" ScaleX="0.82" ScaleY="0.82" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Dot3" Width="8" Height="8" Opacity="0.38"
                     Fill="{ThemeResource TokenInkSecondaryBrush}"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="Dot3Scale" ScaleX="0.82" ScaleY="0.82" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </StackPanel>
    </Border>
</UserControl>
