<Page
    x:Class="LanMessenger.UI.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Settings as grouped rows on thick glass, one group per section: the
         header outside the glass in label-strong, rows at least 44 tall with a
         divider between them and none above the first. The page sits inside a
         ContentDialog that GlassDialog has already made acrylic, so the groups
         are translucent solid rather than acrylic on acrylic. -->
    <ScrollViewer>
        <StackPanel Padding="24,16" Spacing="20" MaxWidth="640">
            <TextBlock Text="Settings"
                       Style="{StaticResource TokenTypeTitlePaneStyle}"
                       Foreground="{ThemeResource TokenInkBrush}" />

            <!-- Username -->
            <TextBlock Text="Display name"
                       Style="{StaticResource TokenTypeLabelStrongStyle}"
                       Foreground="{ThemeResource TokenInkSecondaryBrush}"
                       Margin="14,0,0,-14" />
            <ContentControl Style="{StaticResource GlassSettingsGroupStyle}">
                <StackPanel>
                    <Grid MinHeight="44" Padding="0,6">
                        <TextBox x:Name="UsernameBox"
                                 VerticalAlignment="Center"
                                 PlaceholderText="Your name"
                                 LostFocus="UsernameBox_LostFocus" />
                    </Grid>
                </StackPanel>
            </ContentControl>

            <!-- Inbox directory -->
            <TextBlock Text="Received files folder"
                       Style="{StaticResource TokenTypeLabelStrongStyle}"
                       Foreground="{ThemeResource TokenInkSecondaryBrush}"
                       Margin="14,0,0,-14" />
            <ContentControl Style="{StaticResource GlassSettingsGroupStyle}">
                <StackPanel>
                    <Grid MinHeight="44" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InboxBox"
                                 Grid.Column="0"
                                 VerticalAlignment="Center"
                                 FontFamily="{StaticResource TokenMonoFontFamily}"
                                 IsReadOnly="True" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource GlassPlainButtonStyle}"
                                VerticalAlignment="Center"
                                Content="Browse…"
                                Click="BrowseInbox_Click" />
                    </Grid>
                </StackPanel>
            </ContentControl>

            <TextBlock Text="Screenshots folder"
                       Style="{StaticResource TokenTypeLabelStrongStyle}"
                       Foreground="{ThemeResource TokenInkSecondaryBrush}"
                       Margin="14,0,0,-14" />
            <ContentControl Style="{StaticResource GlassSettingsGroupStyle}">
                <StackPanel>
                    <Grid MinHeight="44" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ScreenshotDirBox"
                                 Grid.Column="0"
                                 VerticalAlignment="Center"
                                 FontFamily="{StaticResource TokenMonoFontFamily}"
                                 IsReadOnly="True" />
                        <Button x:Name="ResetScreenshotDirBtn"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource GlassPlainButtonStyle}"
                                VerticalAlignment="Center"
                                Content="Reset"
                                Visibility="Collapsed"
                                Click="ResetScreenshotDir_Click" />
                        <Button Grid.Column="2"
                                Margin="4,0,0,0"
                                Style="{StaticResource GlassPlainButtonStyle}"
                                VerticalAlignment="Center"
                                Content="Browse…"
                                Click="BrowseScreenshotDir_Click" />
                    </Grid>
                </StackPanel>
            </ContentControl>

            <!-- Background behavior -->
            <TextBlock Text="Background"
                       Style="{StaticResource TokenTypeLabelStrongStyle}"
                       Foreground="{ThemeResource TokenInkSecondaryBrush}"
                       Margin="14,0,0,-14" />
            <ContentControl Style="{StaticResource GlassSettingsGroupStyle}">
                <StackPanel>
                    <Grid MinHeight="44" Padding="0,6">
                        <ToggleSwitch x:Name="CloseToTrayToggle"
                                      Header="Keep running in the background when window is closed"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="CloseToTrayToggle_Toggled">
                            <ToggleSwitch.Resources>
                                <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="TokenBrandBrush"/>
                                <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="TokenBrandHoverBrush"/>
                                <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="TokenBrandPressedBrush"/>
                                <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="TokenBrandBrush"/>
                                <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="TokenBrandHoverBrush"/>
                                <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="TokenBrandPressedBrush"/>
                            </ToggleSwitch.Resources>
                        </ToggleSwitch>
                    </Grid>
                </StackPanel>
            </ContentControl>

            <TextBlock Text="Logging"
                       Style="{StaticResource TokenTypeLabelStrongStyle}"
                       Foreground="{ThemeResource TokenInkSecondaryBrush}"
                       Margin="14,0,0,-14" />
            <ContentControl Style="{StaticResource GlassSettingsGroupStyle}">
                <StackPanel>
                    <TextBlock Text="Detailed diagnostics are always recorded — transfers, connections, discovery, UI events, and crashes. The export contains the active and rotated log files for every channel."
                               Style="{StaticResource TokenTypeLabelStyle}"
                               Foreground="{ThemeResource TokenInkSecondaryBrush}"
                               Margin="0,8"
                               TextWrapping="Wrap" />
                    <Rectangle Height="1" Fill="{ThemeResource TokenDividerBrush}" />
                    <Grid MinHeight="44" Padding="0,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Open Logs Folder"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Click="OpenLogsFolder_Click" />
                            <Button Content="Export Logs…"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Click="ExportLogs_Click" />
                            <TextBlock x:Name="LogExportStatus"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TokenTypeLabelStyle}"
                                       Foreground="{ThemeResource TokenInkSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ContentControl>

            <TextBlock Text="Remote Desktop"
                       Style="{StaticResource TokenTypeLabelStrongStyle}"
                       Foreground="{ThemeResource TokenInkSecondaryBrush}"
                       Margin="14,0,0,-14" />
            <ContentControl Style="{StaticResource GlassSettingsGroupStyle}">
                <StackPanel>
                    <Grid MinHeight="44" Padding="0,6">
                        <ToggleSwitch x:Name="RemoteDesktopToggle"
                                      Header="Allow remote desktop"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="RemoteDesktopToggle_Toggled">
                            <ToggleSwitch.Resources>
                                <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="TokenBrandBrush"/>
                                <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="TokenBrandHoverBrush"/>
                                <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="TokenBrandPressedBrush"/>
                                <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="TokenBrandBrush"/>
                                <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="TokenBrandHoverBrush"/>
                                <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="TokenBrandPressedBrush"/>
                            </ToggleSwitch.Resources>
                        </ToggleSwitch>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource TokenDividerBrush}" />
                    <TextBlock Text="When enabled, a saved contact can ask to view your screen, and separately to control it. You are asked every time — there is no unattended access, and peers who are not in your contacts are ignored without being told anything."
                               Style="{StaticResource TokenTypeLabelStyle}"
                               Foreground="{ThemeResource TokenInkSecondaryBrush}"
                               Margin="0,8"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="RemoteDesktopStopHint"
                               Text="Stop a session at any time from the indicator at the top of the screen, or with Ctrl+Alt+Shift+Esc, which works even while the other side is controlling your keyboard and mouse."
                               Style="{StaticResource TokenTypeLabelStyle}"
                               Foreground="{ThemeResource TokenInkSecondaryBrush}"
                               Margin="0,8"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ContentControl>

            <TextBlock Text="Cloud Relay"
                       Style="{StaticResource TokenTypeLabelStrongStyle}"
                       Foreground="{ThemeResource TokenInkSecondaryBrush}"
                       Margin="14,0,0,-14" />
            <ContentControl Style="{StaticResource GlassSettingsGroupStyle}">
                <StackPanel>
                    <Grid MinHeight="44" Padding="0,6">
                        <ToggleSwitch x:Name="RelayEnabledToggle"
                                      Header="Enable cloud relay"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="RelayEnabledToggle_Toggled">
                            <ToggleSwitch.Resources>
                                <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="TokenBrandBrush"/>
                                <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="TokenBrandHoverBrush"/>
                                <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="TokenBrandPressedBrush"/>
                                <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="TokenBrandBrush"/>
                                <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="TokenBrandHoverBrush"/>
                                <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="TokenBrandPressedBrush"/>
                            </ToggleSwitch.Resources>
                        </ToggleSwitch>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource TokenDividerBrush}" />
                    <TextBlock Text="When enabled, messages sent to offline contacts are stored in the cloud and delivered when they reconnect. Deploy your own Cloudflare Worker (see README) and paste its URL below."
                               Style="{StaticResource TokenTypeLabelStyle}"
                               Foreground="{ThemeResource TokenInkSecondaryBrush}"
                               Margin="0,8"
                               TextWrapping="Wrap" />
                    <Rectangle Height="1" Fill="{ThemeResource TokenDividerBrush}" />
                    <Grid MinHeight="44" Padding="0,6">
                        <TextBox x:Name="RelayUrlBox"
                                 Header="Worker URL"
                                 VerticalAlignment="Center"
                                 PlaceholderText="https://your-worker.workers.dev"
                                 LostFocus="RelayUrlBox_LostFocus" />
                    </Grid>
                </StackPanel>
            </ContentControl>

            <TextBlock Text="Updates"
                       Style="{StaticResource TokenTypeLabelStrongStyle}"
                       Foreground="{ThemeResource TokenInkSecondaryBrush}"
                       Margin="14,0,0,-14" />
            <ContentControl Style="{StaticResource GlassSettingsGroupStyle}">
                <StackPanel>
                    <Grid MinHeight="44" Padding="0,6">
                        <TextBox x:Name="UpdateRepoBox"
                                 Header="GitHub repository (owner/repo)"
                                 VerticalAlignment="Center"
                                 PlaceholderText="felzy613/lan-messenger"
                                 LostFocus="UpdateRepoBox_LostFocus" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource TokenDividerBrush}" />
                    <Grid MinHeight="44" Padding="0,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="CheckUpdatesBtn"
                                    Content="Check Now"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Click="CheckUpdates_Click" />
                            <TextBlock x:Name="UpdateStatusText"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TokenTypeLabelStyle}"
                                       Foreground="{ThemeResource TokenInkSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="UpdatePanel"
                            Background="{ThemeResource TokenInsetFillBrush}"
                            BorderBrush="{ThemeResource TokenBrandBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource TokenRadiusPanel}"
                            Padding="12"
                            Margin="0,4,0,8"
                            Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEBD3;"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TokenAccentInkBrush}" />
                                <TextBlock x:Name="UpdateAvailableText"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource TokenTypeNameStyle}"
                                           Foreground="{ThemeResource TokenInkBrush}" />
                                <Button x:Name="InstallNowBtn"
                                        Content="Install &amp; Restart"
                                        Style="{StaticResource GlassPrimaryButtonStyle}"
                                        Click="InstallNow_Click" />
                            </StackPanel>
                            <!-- Release notes rendered as Markdown (headings, lists, bold,
                                 inline code, links).  Collapsed to ~5 lines initially;
                                 "Show more" expands into a scrollable area. -->
                            <ScrollViewer x:Name="UpdateNotesScroll"
                                          MaxHeight="120"
                                          VerticalScrollBarVisibility="Hidden">
                                <RichTextBlock x:Name="UpdateNotesBlock"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource TokenInkSecondaryBrush}" />
                            </ScrollViewer>
                            <Button x:Name="NotesToggleBtn"
                                    Content="Show more"
                                    Style="{StaticResource GlassPlainButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Click="NotesToggleBtn_Click" />
                            <ProgressBar x:Name="UpdateProgressBar"
                                         Value="0"
                                         Minimum="0"
                                         Maximum="1"
                                         Height="4" MinHeight="4"
                                         CornerRadius="2"
                                         Foreground="{ThemeResource TokenBrandBrush}"
                                         Background="{ThemeResource TokenInsetFillBrush}"
                                         Visibility="Collapsed">
                                <ProgressBar.Resources>
                                    <x:Double x:Key="ProgressBarTrackHeight">4</x:Double>
                                    <x:Double x:Key="ProgressBarMinHeight">4</x:Double>
                                </ProgressBar.Resources>
                            </ProgressBar>
                            <TextBlock x:Name="UpdateProgressText"
                                       Style="{StaticResource TokenTypeLabelStyle}"
                                       Foreground="{ThemeResource TokenInkSecondaryBrush}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ContentControl>

            <!-- Version -->
            <TextBlock Text="About"
                       Style="{StaticResource TokenTypeLabelStrongStyle}"
                       Foreground="{ThemeResource TokenInkSecondaryBrush}"
                       Margin="14,0,0,-14" />
            <ContentControl Style="{StaticResource GlassSettingsGroupStyle}">
                <StackPanel>
                    <Grid MinHeight="44" Padding="0,6">
                        <TextBlock x:Name="VersionText"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TokenInkSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</Page>
