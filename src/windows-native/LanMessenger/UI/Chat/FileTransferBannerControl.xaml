<UserControl
    x:Class="LanMessenger.UI.Chat.FileTransferBannerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A glass capsule under the chat header. Acrylic, because the thread
         keeps scrolling under it. -->
    <ContentControl Style="{StaticResource GlassSurfaceStyle}"
                    CornerRadius="24"
                    Padding="10,8,16,8">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center">
                <Ellipse Fill="{ThemeResource TokenAccentWashBrush}" />
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE8CB;"
                          FontSize="14"
                          Foreground="{ThemeResource TokenAccentInkBrush}" />
            </Grid>

            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                <TextBlock x:Name="LabelText"
                           Style="{StaticResource TokenTypeLabelStrongStyle}"
                           Foreground="{ThemeResource TokenInkBrush}"
                           TextTrimming="CharacterEllipsis" />
                <!-- A 4px brand fill on an inset-fill track. The template draws
                     the track at ProgressBarTrackHeight (1px by default) and the
                     fill at ProgressBarMinHeight, so both are set here. -->
                <ProgressBar x:Name="Progress"
                             Minimum="0" Maximum="1"
                             Height="4" MinHeight="4"
                             CornerRadius="2"
                             Foreground="{ThemeResource TokenBrandBrush}"
                             Background="{ThemeResource TokenInsetFillBrush}">
                    <ProgressBar.Resources>
                        <x:Double x:Key="ProgressBarTrackHeight">4</x:Double>
                        <x:Double x:Key="ProgressBarMinHeight">4</x:Double>
                    </ProgressBar.Resources>
                </ProgressBar>
            </StackPanel>

            <TextBlock x:Name="BytesText"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource TokenMonoFontFamily}"
                       FontSize="11"
                       Foreground="{ThemeResource TokenInkSecondaryBrush}" />
        </Grid>
    </ContentControl>
</UserControl>
