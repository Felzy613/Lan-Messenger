<UserControl
    x:Class="LanMessenger.UI.Chat.MessageBubbleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Padding="0,2">
        <!-- No sender name above the bubble. Every conversation here is
             one-to-one, the header already names the peer, and every incoming
             bubble is from that one person — the label just repeated their
             name down the whole thread. HorizontalAlignment is set on this
             column, not the Border, so the bubble sits on the right side. -->
        <StackPanel x:Name="BubbleColumn" Spacing="2" HorizontalAlignment="Left">
        <!-- CanDrag is switched on in Refresh() for file bubbles whose file is
             still on disk, so an attachment can be dragged straight out to
             Explorer, Outlook, or anything else that takes a file. -->
        <!-- Tinted glass: a translucent solid brush from Theme (the opaque
             -fallback token with transparency effects off) and the rim. Never
             an AcrylicBrush: only the wallpaper is behind a bubble, and dozens
             of blurred surfaces in a virtualised list cost frames for nothing
             anyone can see. The far-side margin (60px clear) and the tail
             corner are set in Refresh(). -->
        <Border x:Name="Bubble"
                CornerRadius="{StaticResource TokenRadiusBubble}"
                Padding="10,7,10,7"
                MaxWidth="{StaticResource TokenSizeBubbleMax}"
                BorderThickness="1"
                BorderBrush="{ThemeResource GlassRimBrush}"
                CanDrag="False"
                DragStarting="Bubble_DragStarting">
            <Border.ContextFlyout>
                <MenuFlyout x:Name="BubbleMenu" Opening="BubbleMenu_Opening">
                    <MenuFlyoutItem x:Name="ReplyMenu" Text="Reply" Click="ReplyMenu_Click" />
                    <MenuFlyoutItem Text="Copy"  Click="CopyMenu_Click" />
                    <MenuFlyoutItem x:Name="EditMenu"
                                    Text="Edit"
                                    Click="EditMenu_Click"
                                    Visibility="Collapsed" />
                    <MenuFlyoutItem x:Name="ShowInExplorerMenu"
                                    Text="Show in folder"
                                    Click="ShowInExplorerMenu_Click"
                                    Visibility="Collapsed" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Delete for Me" Click="DeleteForMeMenu_Click" />
                    <MenuFlyoutItem x:Name="DeleteForEveryoneMenu"
                                    Text="Delete for Everyone"
                                    Click="DeleteForEveryoneMenu_Click" />
                </MenuFlyout>
            </Border.ContextFlyout>
            <StackPanel Spacing="2">

                <!-- Reply chip — shows a thumbnail for image/video replies, a doc
                     icon for file replies, and plain text for text replies. -->
                <!-- inset-fill, concentric with the bubble: 16 - 10 padding = 6. -->
                <Border x:Name="ReplyChip"
                        Background="{ThemeResource TokenInsetFillBrush}"
                        CornerRadius="{StaticResource TokenRadiusChip}"
                        Padding="6,4"
                        Margin="0,0,0,4"
                        Tapped="ReplyChip_Tapped"
                        Visibility="Collapsed">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{ThemeResource TokenBrandBrush}" CornerRadius="2" />
                        <!-- Optional thumbnail / icon for media and file replies -->
                        <Border x:Name="ReplyChipThumbnailBorder"
                                Grid.Column="1"
                                Width="36" Height="36"
                                CornerRadius="{StaticResource TokenRadiusTail}"
                                Background="{ThemeResource TokenInsetFillBrush}"
                                Visibility="Collapsed">
                            <Grid>
                                <Image x:Name="ReplyChipImage"
                                       Stretch="UniformToFill"
                                       Visibility="Collapsed" />
                                <FontIcon x:Name="ReplyChipIcon"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="18"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="0" VerticalAlignment="Center">
                            <!-- Colours by side, from Refresh(): accent ink and the
                                 bubble's meta colour. -->
                            <TextBlock x:Name="ReplySender"
                                       Style="{StaticResource TokenTypeCaptionStrongStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ReplyPreview"
                                       Style="{StaticResource TokenTypeCaptionStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Inline image preview (visible only for image MediaKind).
                     MaxWidth caps the bubble width so a 4K image cannot blow out
                     the chat list layout. Tap opens the modal viewer. -->
                <Border x:Name="ImageTile"
                        CornerRadius="{StaticResource TokenRadiusMedia}"
                        Visibility="Collapsed"
                        Tapped="MediaTile_Tapped">
                    <Grid>
                        <Image x:Name="ImagePreview"
                               Stretch="Uniform"
                               MaxWidth="280"
                               MaxHeight="280" />
                        <ProgressRing x:Name="ImageProgress"
                                      IsActive="True"
                                      Width="28" Height="28"
                                      Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- Inline video tile.  MediaPlayerElement is heavy, so the chat
                     list shows a poster tile (filename + play icon) and the
                     player is only constructed inside the modal preview. -->
                <Border x:Name="VideoTile"
                        CornerRadius="{StaticResource TokenRadiusMedia}"
                        Background="{ThemeResource TokenInsetFillBrush}"
                        Padding="10"
                        Visibility="Collapsed"
                        Tapped="MediaTile_Tapped">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0"
                              Width="60" Height="60"
                              Background="{ThemeResource TokenScrimBrush}"
                              CornerRadius="{StaticResource TokenRadiusCard}">
                            <FontIcon Glyph="&#xE714;"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="28"
                                      Foreground="{ThemeResource TokenInkInverseBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="VideoFilename"
                                       Style="{StaticResource TokenTypeFileNameStyle}"
                                       Foreground="{ThemeResource TokenInkBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <TextBlock x:Name="VideoHintText"
                                       Text="Tap to play"
                                       Style="{StaticResource TokenTypeCaptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Generic message text — hidden when an inline media tile is shown. -->
                <TextBlock x:Name="MessageText"
                           TextWrapping="Wrap"
                           Style="{StaticResource TokenTypeMessageStyle}" />

                <!-- File actions row (visible for non-media file bubbles only).
                     Open launches the file with its default app; "Show in folder"
                     opens Explorer with the file selected. -->
                <StackPanel x:Name="FileActions"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="Collapsed">
                    <Button x:Name="OpenFileBtn"
                            Content="Open"
                            Style="{StaticResource GlassPillAccentButtonStyle}"
                            Click="OpenFileBtn_Click" />
                    <Button x:Name="ShowInExplorerBtn"
                            Content="Show in folder"
                            Style="{StaticResource GlassPillButtonStyle}"
                            Click="ShowInExplorerBtn_Click"
                            ToolTipService.ToolTip="Open File Explorer with this file selected" />
                </StackPanel>

                <!-- File-missing footer used when the referenced file no longer
                     exists on disk (moved or deleted after history was written). -->
                <TextBlock x:Name="FileMissingText"
                           Text="File no longer available"
                           Style="{StaticResource TokenTypeCaptionStyle}"
                           Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal"
                            Spacing="4"
                            HorizontalAlignment="Right"
                            Margin="0,2,0,0">
                    <!-- The meta row takes the bubble's meta colour from
                         Refresh(): ink-secondary incoming, meta-out outgoing.
                         Never Opacity: dimming is what took these below 4.5:1,
                         and ink-secondary itself fails on the light green. -->
                    <!-- "edited" marker — shown for messages whose sender
                         replaced the text after sending. -->
                    <TextBlock x:Name="EditedText"
                               Text="edited"
                               Style="{StaticResource TokenTypeMetaStyle}"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="TimestampText"
                               Style="{StaticResource TokenTypeMetaStyle}" />
                    <!-- Relay delivery badge — hidden for direct LAN messages. -->
                    <StackPanel x:Name="RelayBadge"
                                Orientation="Horizontal"
                                Spacing="2"
                                Visibility="Collapsed">
                        <FontIcon x:Name="RelayIcon"
                                  Glyph="&#xE753;"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="9" />
                        <TextBlock x:Name="RelayText"
                                   Text="via relay"
                                   Style="{StaticResource TokenTypeMicroStyle}" />
                    </StackPanel>
                    <!-- Status check marks (text glyphs). -->
                    <TextBlock x:Name="StatusText"
                               FontSize="11"
                               FontFamily="Segoe UI Symbol" />
                </StackPanel>
            </StackPanel>
        </Border>
        </StackPanel>
    </Grid>
</UserControl>
