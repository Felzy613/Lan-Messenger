<Page
    x:Class="LanMessenger.UI.Chat.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanMessenger.UI.Chat"
    xmlns:ui="using:LanMessenger.UI">

    <!-- The whole thread is the drop target, not just the composer strip:
         aiming at a 48 px bar at the bottom of the window is the kind of thing
         you only get right on the second try. -->
    <Grid Background="{ThemeResource AppChatBackgroundBrush}"
          AllowDrop="True"
          DragEnter="Page_DragEnter"
          DragOver="Page_DragOver"
          DragLeave="Page_DragLeave"
          Drop="Page_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: avatar + name + online dot + typing -->
        <Grid Grid.Row="0"
              Padding="16,12"
              ColumnSpacing="12"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <ui:AvatarControl x:Name="HeaderAvatar" Width="40" Height="40" />
                <Ellipse x:Name="HeaderOnlineDot"
                         Width="11" Height="11"
                         Fill="#25D366"
                         Stroke="White" StrokeThickness="2"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Visibility="Collapsed" />
                <!-- HeaderOnlineDot kept for layout; online state is shown inline after the name -->
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <!-- Name row: name + inline online dot, matching macOS header layout -->
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderName"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <Ellipse x:Name="HeaderNameDot"
                             Width="8" Height="8"
                             VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="HeaderSubtext"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- Swapped in for the Online/Offline caption while the peer is
                     typing, so the header keeps its height and the state is
                     still legible when the thread is scrolled up and the
                     in-thread typing bubble is off screen. Dot size is set in
                     the code-behind. -->
                <ui:TypingIndicatorControl x:Name="HeaderTyping"
                                           HorizontalAlignment="Left"
                                           Margin="0,3,0,2" />
            </StackPanel>
        </Grid>

        <!-- File transfer banner -->
        <local:FileTransferBannerControl x:Name="TransferBanner"
                                          Grid.Row="1"
                                          Visibility="Collapsed" />

        <!-- Messages list — ListView provides built-in virtualization for smooth scrolling -->
        <ListView x:Name="MessagesList"
                  Grid.Row="2"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  Padding="12,8"
                  Background="{ThemeResource AppChatBackgroundBrush}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:MessageRowViewModel">
                    <local:MessageBubbleControl Row="{Binding}" />
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,2" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
            <!-- The typing bubble sits at the end of the thread, where the
                 peer's message is about to appear. As the list's Footer it
                 scrolls with the messages and stays out of the item collection,
                 so no merge/diff path has to know about it. -->
            <ListView.Footer>
                <ui:TypingIndicatorControl x:Name="ThreadTyping" Margin="0,2,0,2" />
            </ListView.Footer>
        </ListView>

        <!-- Jump to latest. Floats over the bottom-right of the thread and is
             only shown once the view is scrolled away from the newest message —
             new messages no longer yank a reader back down, so there has to be
             a way back. -->
        <Button x:Name="JumpToLatestBtn"
                Grid.Row="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,10"
                Width="34" Height="34"
                Padding="0"
                CornerRadius="17"
                Visibility="Collapsed"
                ToolTipService.ToolTip="Jump to latest"
                Click="JumpToLatestBtn_Click">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      Glyph="&#xE70D;"
                      FontSize="13" />
        </Button>

        <!-- Reply banner (shown when replying, or when editing a sent message) -->
        <Border x:Name="ReplyBanner"
                Grid.Row="3"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,8"
                Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Fill="{ThemeResource AppReplyAccentBrush}" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock x:Name="ReplyBannerWho"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource AppReplyAccentTextBrush}" />
                    <TextBlock x:Name="ReplyBannerPreview"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                </StackPanel>
                <Button Grid.Column="2"
                        x:Name="CancelReplyBtn"
                        Content="✕"
                        Padding="6,2"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CancelReplyBtn_Click" />
            </Grid>
        </Border>

        <!-- Composer -->
        <local:ComposerControl x:Name="Composer"
                               Grid.Row="4"
                               BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                               BorderThickness="0,1,0,0" />

        <!-- Drop affordance. Spans every row and ignores hit-testing so it
             never intercepts the drop it is advertising. -->
        <Border x:Name="DropOverlay"
                Grid.Row="0" Grid.RowSpan="5"
                Background="#1425D366"
                BorderBrush="#25D366"
                BorderThickness="2"
                CornerRadius="12"
                Margin="8"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE723;"
                          FontSize="34"
                          Foreground="#25D366" />
                <TextBlock x:Name="DropOverlayText"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
