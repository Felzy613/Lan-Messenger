<UserControl
    x:Class="LanMessenger.UI.Chat.ComposerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- File drops are owned by ChatPage, which covers the whole thread. A
         second drop target here would either double-send the file or shadow the
         page's drop affordance on this strip.

         The composer floats over the bottom of the thread: a transparent root
         holding one glass pill (the banner, attach, screenshot and the field)
         and the send orb beside it. The pill is acrylic because messages scroll
         underneath it. -->
    <Grid ColumnSpacing="8" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ContentControl x:Name="Pill"
                        Grid.Column="0"
                        Style="{StaticResource GlassSurfaceStyle}"
                        CornerRadius="22"
                        Padding="4">
            <StackPanel>
                <!-- Reply / edit banner: grows inside the pill, above the field. -->
                <Border x:Name="BannerHost"
                        Background="{ThemeResource TokenInsetFillBrush}"
                        CornerRadius="18"
                        Margin="2,2,2,4"
                        Padding="10,6,8,6"
                        Visibility="Collapsed">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{ThemeResource TokenBrandBrush}"
                                CornerRadius="2" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="BannerTitle"
                                       Style="{StaticResource TokenTypeCaptionStrongStyle}"
                                       Foreground="{ThemeResource TokenAccentInkBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="BannerPreview"
                                       Style="{StaticResource TokenTypeLabelStyle}"
                                       Foreground="{ThemeResource TokenInkSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                        </StackPanel>
                        <Button x:Name="BannerCancelBtn"
                                Grid.Column="2"
                                Style="{StaticResource GlassIconButtonStyle}"
                                Width="24" Height="24"
                                CornerRadius="12"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Cancel"
                                AutomationProperties.Name="Cancel"
                                Click="BannerCancelBtn_Click">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Glyph="&#xE711;"
                                      FontSize="10" />
                        </Button>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Attach button — Segoe MDL2 "Attach" glyph matches the macOS SF Symbol paperclip -->
                    <Button x:Name="AttachBtn"
                            Grid.Column="0"
                            Style="{StaticResource GlassIconButtonStyle}"
                            VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="Attach file"
                            AutomationProperties.Name="Attach file"
                            Click="AttachBtn_Click">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  Glyph="&#xE723;"
                                  FontSize="16" />
                    </Button>

                    <!-- Screenshot button — routes the capture through the normal
                         attachment pipeline. Disabled while a capture is in flight
                         so a double-tap can't enqueue two screenshots in a row. -->
                    <Button x:Name="ScreenshotBtn"
                            Grid.Column="1"
                            Style="{StaticResource GlassIconButtonStyle}"
                            VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="Capture a window screenshot"
                            AutomationProperties.Name="Capture a window screenshot"
                            Click="ScreenshotBtn_Click">
                        <Grid>
                            <FontIcon x:Name="ScreenshotIcon"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Glyph="&#xE722;"
                                      FontSize="16" />
                            <ProgressRing x:Name="ScreenshotProgress"
                                          IsActive="True"
                                          Width="18" Height="18"
                                          Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <!-- The field sits straight in the pill: the pill is the field's shape. -->
                    <TextBox x:Name="InputBox"
                             Grid.Column="2"
                             AllowDrop="False"
                             PlaceholderText="Message"
                             AcceptsReturn="False"
                             TextWrapping="Wrap"
                             MinHeight="32"
                             MaxHeight="138"
                             FontSize="14"
                             Padding="8,6"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{ThemeResource TokenInkBrush}"
                             VerticalAlignment="Bottom"
                             VerticalContentAlignment="Center"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             KeyDown="InputBox_KeyDown"
                             TextChanged="InputBox_TextChanged"
                             Paste="InputBox_Paste">
                        <!-- Suppress TextBox's own focus/hover chrome: the pill is the field. -->
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused"      Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"  Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused"       Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver"   Color="Transparent"/>
                            <StaticResource x:Key="TextControlForegroundFocused"        ResourceKey="TokenInkBrush"/>
                            <StaticResource x:Key="TextControlPlaceholderForeground"             ResourceKey="TokenInkSecondaryBrush"/>
                            <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver"  ResourceKey="TokenInkSecondaryBrush"/>
                            <StaticResource x:Key="TextControlPlaceholderForegroundFocused"      ResourceKey="TokenInkSecondaryBrush"/>
                        </TextBox.Resources>
                    </TextBox>
                </Grid>
            </StackPanel>
        </ContentControl>

        <!-- The send orb. Its glyph takes its colour from the style (on-brand,
             or ink-secondary while there is nothing to send), so the FontIcon
             never sets Foreground: it was hard-coded White, which is 2:1 on the
             brand green and silently overrode every ButtonForeground resource. -->
        <Button x:Name="SendBtn"
                Grid.Column="1"
                Style="{StaticResource GlassSendButtonStyle}"
                VerticalAlignment="Bottom"
                Margin="0,0,0,2"
                Click="SendBtn_Click"
                ToolTipService.ToolTip="Send"
                AutomationProperties.Name="Send">
            <FontIcon x:Name="SendIcon"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      Glyph="&#xE74A;"
                      FontSize="15" />
        </Button>
    </Grid>
</UserControl>
