<Window
    x:Class="LanMessenger.UI.RemoteDesktop.RemoteConsentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: the peer is named, because "someone wants to view your
             screen" is not a sentence anybody can act on. -->
        <StackPanel Grid.Row="0" Padding="16" Spacing="4">
            <TextBlock x:Name="TitleText"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ExplanationText"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderThickness="0,1,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Padding="16">
            <StackPanel Spacing="10">
                <!-- Present only when the key is not the pinned one. There is no
                     badge on the safe path: a green tick on every prompt trains
                     people to look for the tick instead of the words. -->
                <Border x:Name="WarningPanel"
                        Background="#33C04B1A"
                        CornerRadius="8"
                        Padding="10"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#E8A33D" />
                        <TextBlock x:Name="WarningText"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   MaxWidth="330" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Address" FontSize="11" Width="58"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="AddressText" FontSize="12" IsTextSelectionEnabled="True" />
                </StackPanel>

                <!-- Monospaced and never truncated: this is the one string a
                     careful user reads character by character against something
                     the peer read out to them. -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Key" FontSize="11" Width="58"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="FingerprintText"
                               FontSize="12"
                               FontFamily="Consolas"
                               IsTextSelectionEnabled="True" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Padding="16" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Stated rather than animated. A shrinking bar reads as pressure
                 to click something; a number reads as a fact. -->
            <TextBlock x:Name="CountdownText"
                       Grid.Column="0"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Decline is the default. Enter declines, Escape declines, the
                 close button declines, and the countdown declines. -->
            <Button x:Name="DeclineButton"
                    Grid.Column="1"
                    Content="Decline"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="Decline_Click" />

            <!-- Deliberately carries no keyboard shortcut: accepting has to be
                 aimed at and clicked. -->
            <Button x:Name="AcceptButton"
                    Grid.Column="2"
                    Click="Accept_Click" />
        </Grid>
    </Grid>
</Window>
