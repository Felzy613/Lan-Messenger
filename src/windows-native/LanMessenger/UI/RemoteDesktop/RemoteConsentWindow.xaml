<Window
    x:Class="LanMessenger.UI.RemoteDesktop.RemoteConsentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Transparent, so the window's DesktopAcrylicBackdrop (set in the
         constructor) makes the whole prompt real glass over the desktop. -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: the peer is named, because "someone wants to view your
             screen" is not a sentence anybody can act on. -->
        <StackPanel Grid.Row="0" Padding="20,16,20,12" Spacing="4">
            <TextBlock x:Name="TitleText"
                       Style="{StaticResource TokenTypeTitleSheetStyle}"
                       Foreground="{ThemeResource TokenInkBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ExplanationText"
                       Style="{StaticResource TokenTypeLabelStyle}"
                       Foreground="{ThemeResource TokenInkSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Padding="20,0" Spacing="10">
            <!-- Present only when the key is not the pinned one. There is no
                 badge on the safe path: a green tick on every prompt trains
                 people to look for the tick instead of the words. Colour here,
                 and only here, because something is actually wrong. -->
            <Border x:Name="WarningPanel"
                    Background="{ThemeResource TokenWarningWashBrush}"
                    CornerRadius="{StaticResource TokenRadiusCard}"
                    Padding="10"
                    Visibility="Collapsed">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14"
                              VerticalAlignment="Top"
                              Margin="0,1,0,0"
                              Foreground="{ThemeResource TokenWarningInkBrush}" />
                    <TextBlock x:Name="WarningText"
                               Grid.Column="1"
                               Style="{StaticResource TokenTypeLabelStyle}"
                               Foreground="{ThemeResource TokenInkBrush}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- The address and key card. -->
            <Border Background="{ThemeResource TokenInsetFillBrush}"
                    CornerRadius="{StaticResource TokenRadiusCard}"
                    Padding="10">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Address"
                                   Style="{StaticResource TokenTypeCaptionStyle}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TokenInkSecondaryBrush}" />
                        <TextBlock x:Name="AddressText"
                                   Grid.Column="1"
                                   Style="{StaticResource TokenTypeCodeStyle}"
                                   Foreground="{ThemeResource TokenInkBrush}"
                                   IsTextSelectionEnabled="True" />
                    </Grid>

                    <!-- Monospaced and never truncated: this is the one string a
                         careful user reads character by character against something
                         the peer read out to them. It wraps rather than trims. -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Key"
                                   Style="{StaticResource TokenTypeCaptionStyle}"
                                   VerticalAlignment="Top"
                                   Margin="0,1,0,0"
                                   Foreground="{ThemeResource TokenInkSecondaryBrush}" />
                        <TextBlock x:Name="FingerprintText"
                                   Grid.Column="1"
                                   Style="{StaticResource TokenTypeCodeStyle}"
                                   Foreground="{ThemeResource TokenInkBrush}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Padding="20,16,20,20" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Stated rather than animated. A shrinking bar reads as pressure
                 to click something; a number reads as a fact. -->
            <TextBlock x:Name="CountdownText"
                       Grid.Column="0"
                       Style="{StaticResource TokenTypeCaptionStyle}"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TokenInkSecondaryBrush}" />

            <!-- Decline is the default and the primary style. Enter declines
                 (it has focus), Escape declines, the close button declines, and
                 the countdown declines. Never swap these to make Allow primary. -->
            <Button x:Name="DeclineButton"
                    Grid.Column="1"
                    Content="Decline"
                    Style="{StaticResource GlassPrimaryButtonStyle}"
                    Click="Decline_Click">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>

            <!-- Deliberately carries no keyboard shortcut: accepting has to be
                 aimed at and clicked. -->
            <Button x:Name="AcceptButton"
                    Grid.Column="2"
                    Style="{StaticResource GlassButtonStyle}"
                    Click="Accept_Click" />
        </Grid>
    </Grid>
</Window>
