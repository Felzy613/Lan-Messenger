<Page
    x:Class="LanMessenger.UI.Sidebar.ContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanMessenger.UI.Sidebar"
    xmlns:ui="using:LanMessenger.UI">

    <Grid RowSpacing="0" Width="400" Height="380">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search: the glass search field with the magnifier laid over its
             leading padding, exactly as on the New Message sheet. -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox"
                     Style="{StaticResource GlassSearchFieldStyle}"
                     PlaceholderText="Search by name or IP"
                     AutomationProperties.Name="Search contacts"
                     TextChanged="SearchBox_TextChanged" />
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      Glyph="&#xE721;"
                      FontSize="13"
                      Margin="13,0,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      Foreground="{ThemeResource TokenInkSecondaryBrush}" />
        </Grid>

        <!-- New contact: a whole-row button, matching macOS's placement. -->
        <Button Grid.Row="1"
                x:Name="NewContactBtn"
                Style="{StaticResource GlassRowButtonStyle}"
                Padding="8,6"
                Click="AddFromPeers_Click"
                ToolTipService.ToolTip="Find peers on your network and add them as contacts">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Grid Width="{StaticResource TokenSizeAvatarRow}" Height="{StaticResource TokenSizeAvatarRow}">
                    <Ellipse Fill="{ThemeResource TokenBrandBrush}" />
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xE8FA;"
                              FontSize="18"
                              Foreground="{ThemeResource TokenOnBrandBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="New contact"
                           VerticalAlignment="Center"
                           Style="{StaticResource TokenTypeNameStyle}"
                           Foreground="{ThemeResource TokenInkBrush}" />
            </StackPanel>
        </Button>

        <Rectangle Grid.Row="2"
                   Height="1"
                   Fill="{ThemeResource TokenDividerBrush}"
                   Margin="8,6,8,0" />

        <!-- Contact list — one flat "Contacts" section, matching macOS (no
             Online/Offline split). Items are built programmatically so a
             single section-header item can be inserted without a
             CollectionViewSource. -->
        <ListView x:Name="ContactsList"
                  Grid.Row="3"
                  SelectionMode="None"
                  ItemContainerStyle="{StaticResource GlassListItemStyle}" />

        <!-- Empty state: no contacts, or no search matches -->
        <StackPanel x:Name="EmptyState"
                    Grid.Row="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="Collapsed">
            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                <Ellipse Fill="{ThemeResource TokenGlassClearBrush}"
                         Stroke="{ThemeResource GlassRimBrush}"
                         StrokeThickness="1" />
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE779;"
                          FontSize="26"
                          Foreground="{ThemeResource TokenInkSecondaryBrush}" />
            </Grid>
            <TextBlock x:Name="EmptyTitle"
                       Text="No saved contacts"
                       Style="{StaticResource TokenTypeTitleSheetStyle}"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TokenInkBrush}" />
            <TextBlock x:Name="EmptySubtitle"
                       Text="Choose &quot;New contact&quot; to find peers on your network."
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       MaxWidth="260"
                       TextWrapping="Wrap"
                       Style="{StaticResource TokenTypeLabelStyle}"
                       Foreground="{ThemeResource TokenInkSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
