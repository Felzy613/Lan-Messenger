<Page
    x:Class="LanMessenger.UI.Sidebar.ContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanMessenger.UI.Sidebar"
    xmlns:ui="using:LanMessenger.UI">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <Border Grid.Row="0"
                Padding="12,10,12,6">
            <Grid ColumnSpacing="8"
                  Padding="10,6"
                  Background="{ThemeResource ControlFillColorDefaultBrush}"
                  CornerRadius="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE721;"
                          FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         PlaceholderText="Search by name or IP"
                         BorderThickness="0"
                         Background="Transparent"
                         TextChanged="SearchBox_TextChanged">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused"     Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused"      Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver"  Color="Transparent"/>
                    </TextBox.Resources>
                </TextBox>
                <Button x:Name="ClearSearchBtn"
                        Grid.Column="2"
                        Width="24" Height="24"
                        Padding="0"
                        CornerRadius="12"
                        BorderThickness="0"
                        Background="Transparent"
                        Visibility="Collapsed"
                        Click="ClearSearch_Click">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xE711;"
                              FontSize="10"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- New contact — full-width row, matching macOS's placement/style. -->
        <Button Grid.Row="1"
                x:Name="NewContactBtn"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Padding="16,8"
                Background="Transparent"
                BorderThickness="0"
                Click="AddFromPeers_Click"
                ToolTipService.ToolTip="Find peers on your network and add them as contacts">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Grid Width="44" Height="44">
                    <Ellipse Fill="#25D366" />
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xE8FA;"
                              FontSize="18"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="New contact"
                           VerticalAlignment="Center"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
            </StackPanel>
        </Button>

        <Rectangle Grid.Row="2"
                   Height="1"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                   Margin="16,4,16,0" />

        <!-- Contact list — one flat "Contacts" section, matching macOS (no
             Online/Offline split). Items are built programmatically so a
             single section-header item can be inserted without a
             CollectionViewSource. -->
        <ListView x:Name="ContactsList"
                  Grid.Row="3"
                  SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding"                    Value="0" />
                    <Setter Property="MinHeight"                  Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Empty state: no contacts, or no search matches -->
        <StackPanel x:Name="EmptyState"
                    Grid.Row="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="Collapsed">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      Glyph="&#xE779;"
                      FontSize="44"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="EmptyTitle"
                       Text="No saved contacts"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="EmptySubtitle"
                       Text="Click &quot;New contact&quot; to find peers on your network."
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
