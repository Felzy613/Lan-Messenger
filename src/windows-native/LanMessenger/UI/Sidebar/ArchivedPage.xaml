<Page
    x:Class="LanMessenger.UI.Sidebar.ArchivedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanMessenger.UI.Sidebar"
    xmlns:ui="using:LanMessenger.UI">

    <!-- Archived conversations fill the chat pane: one glass panel on the
         Mica, like the sidebar beside it, holding a back button, the title,
         and the rows. Translucent solid rather than acrylic, because nothing
         scrolls under the panel itself. -->
    <ContentControl Style="{StaticResource GlassSurfaceStyle}"
                    Background="{ThemeResource TokenGlassRegularBrush}"
                    CornerRadius="{StaticResource TokenRadiusPanel}"
                    Margin="8,0,8,8"
                    Padding="8">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8" Padding="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackBtn"
                        Style="{StaticResource GlassIconButtonStyle}"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Back to chats"
                        AutomationProperties.Name="Back to chats"
                        Click="BackBtn_Click">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xE72B;"
                              FontSize="14" />
                </Button>
                <TextBlock Grid.Column="1"
                           Text="Archived"
                           Style="{StaticResource TokenTypeTitlePaneStyle}"
                           Foreground="{ThemeResource TokenInkBrush}"
                           VerticalAlignment="Center" />
            </Grid>

            <ListView x:Name="ArchivedList"
                      Grid.Row="1"
                      SelectionMode="None"
                      ItemContainerStyle="{StaticResource GlassListItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ConversationRowViewModel">
                        <Grid ColumnSpacing="12" Padding="8,6" Height="{StaticResource TokenSizeRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:AvatarControl Grid.Column="0"
                                              Width="{StaticResource TokenSizeAvatarRow}"
                                              Height="{StaticResource TokenSizeAvatarRow}"
                                              VerticalAlignment="Center"
                                              NameText="{x:Bind PeerName, Mode=OneWay}"
                                              PhotoB64="{x:Bind PhotoB64, Mode=OneWay}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind PeerName, Mode=OneWay}"
                                           Style="{StaticResource TokenTypeNameStyle}"
                                           Foreground="{ThemeResource TokenInkBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind LastMessage, Mode=OneWay}"
                                           Visibility="{x:Bind local:ArchivedPage.ShownIfAny(LastMessage), Mode=OneWay}"
                                           Style="{StaticResource TokenTypePreviewStyle}"
                                           Foreground="{ThemeResource TokenInkSecondaryBrush}"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <Button Content="Open"
                                        Style="{StaticResource GlassPillAccentButtonStyle}"
                                        Tag="{x:Bind PeerIP}"
                                        Click="OpenBtn_Click" />
                                <Button Content="Unarchive"
                                        Style="{StaticResource GlassPillButtonStyle}"
                                        Tag="{x:Bind PeerIP}"
                                        Click="UnarchiveBtn_Click" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- The EmptyState recipe: a clear-glass disc, a title, one line. -->
            <StackPanel x:Name="EmptyState"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="Collapsed">
                <Grid Width="64" Height="64" HorizontalAlignment="Center">
                    <Ellipse Fill="{ThemeResource TokenGlassClearBrush}"
                             Stroke="{ThemeResource GlassRimBrush}"
                             StrokeThickness="1" />
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xE7B8;"
                              FontSize="26"
                              Foreground="{ThemeResource TokenInkSecondaryBrush}" />
                </Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="Nothing archived"
                               HorizontalAlignment="Center"
                               Style="{StaticResource TokenTypeTitlePaneStyle}"
                               Foreground="{ThemeResource TokenInkBrush}" />
                    <TextBlock Text="Archive a conversation from its menu in the sidebar to tuck it away here."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="240"
                               TextWrapping="Wrap"
                               Style="{StaticResource TokenTypeLabelStyle}"
                               Foreground="{ThemeResource TokenInkSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ContentControl>
</Page>
