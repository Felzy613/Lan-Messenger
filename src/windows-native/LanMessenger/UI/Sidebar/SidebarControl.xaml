<UserControl
    x:Class="LanMessenger.UI.Sidebar.SidebarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanMessenger.UI.Sidebar">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Conversation list -->
        <ListView x:Name="ConversationList"
                  Grid.Row="0"
                  SelectionMode="Single"
                  SelectionChanged="ConversationList_SelectionChanged">
            <!-- Selected is a glass-thick lozenge, not Fluent's accent pill at
                 the leading edge; hover is glass-hover. Per-instance resources,
                 because a Style cannot set Resources (WMC0095). Theme
                 dictionaries, because glass-thick differs between themes and a
                 plain StaticResource alias would freeze whichever was current
                 at load. High Contrast is left to the system's own resources. -->
            <ListView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected"            Color="{ThemeResource TokenGlassThickColor}" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource TokenGlassThickColor}" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed"     Color="{ThemeResource TokenGlassThickColor}" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver"         Color="{ThemeResource TokenGlassHoverColor}" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPressed"             Color="{ThemeResource TokenGlassPressedColor}" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected"            Color="{ThemeResource TokenGlassThickColor}" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource TokenGlassThickColor}" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed"     Color="{ThemeResource TokenGlassThickColor}" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver"         Color="{ThemeResource TokenGlassHoverColor}" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPressed"             Color="{ThemeResource TokenGlassPressedColor}" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="CornerRadius" Value="{StaticResource TokenRadiusRow}" />
                    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource TokenFocusRingBrush}" />
                    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ConversationRowViewModel">
                    <local:ConversationRowControl Row="{Binding}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state overlay: the EmptyState recipe, with its own copy. -->
        <StackPanel x:Name="EmptyState"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                <Ellipse Fill="{ThemeResource TokenGlassClearBrush}"
                         Stroke="{ThemeResource GlassRimBrush}"
                         StrokeThickness="1" />
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE8BD;"
                          FontSize="26"
                          Foreground="{ThemeResource TokenInkSecondaryBrush}" />
            </Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="No conversations"
                           HorizontalAlignment="Center"
                           Style="{StaticResource TokenTypeTitlePaneStyle}"
                           Foreground="{ThemeResource TokenInkBrush}" />
                <TextBlock Text="Click the pencil icon above to start a chat with a saved contact."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="240"
                           TextWrapping="Wrap"
                           Style="{StaticResource TokenTypeLabelStyle}"
                           Foreground="{ThemeResource TokenInkSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Archived: always the LAST row, only while something is archived. -->
        <Button x:Name="ArchivedSection"
                Grid.Row="1"
                Style="{StaticResource GlassRowButtonStyle}"
                Height="52"
                Margin="0,2,0,0"
                Click="ArchivedSection_Click"
                Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center">
                    <Ellipse Fill="{ThemeResource TokenAccentWashBrush}" />
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xE7B8;"
                              FontSize="14"
                              Foreground="{ThemeResource TokenAccentInkBrush}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Archived"
                               Style="{StaticResource TokenTypeNameStyle}"
                               Foreground="{ThemeResource TokenInkBrush}" />
                    <TextBlock x:Name="ArchivedSubtitle"
                               Style="{StaticResource TokenTypeCaptionStyle}"
                               Foreground="{ThemeResource TokenInkSecondaryBrush}" />
                </StackPanel>
                <FontIcon Grid.Column="2"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE76C;"
                          FontSize="12"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TokenInkSecondaryBrush}" />
            </Grid>
        </Button>
    </Grid>
</UserControl>
