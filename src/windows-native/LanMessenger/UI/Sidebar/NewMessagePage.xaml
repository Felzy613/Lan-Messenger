<Page
    x:Class="LanMessenger.UI.Sidebar.NewMessagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="0" Width="400" Height="340">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search: the glass search field, with the magnifier laid over its
             leading padding. Its own clear button replaces the one this sheet
             used to draw. Same as ContactsPage, so the two sheets match. -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox"
                     Style="{StaticResource GlassSearchFieldStyle}"
                     PlaceholderText="Search contacts"
                     AutomationProperties.Name="Search contacts"
                     TextChanged="SearchBox_TextChanged" />
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      Glyph="&#xE721;"
                      FontSize="13"
                      Margin="13,0,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      Foreground="{ThemeResource TokenInkSecondaryBrush}" />
        </Grid>

        <!-- Contact list -->
        <ListView x:Name="ContactsList"
                  Grid.Row="1"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="ContactsList_ItemClick"
                  ItemContainerStyle="{StaticResource GlassListItemStyle}" />

        <!-- Empty state: no saved contacts, or no search matches -->
        <StackPanel x:Name="EmptyState"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="Collapsed">
            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                <Ellipse Fill="{ThemeResource TokenGlassClearBrush}"
                         Stroke="{ThemeResource GlassRimBrush}"
                         StrokeThickness="1" />
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE8FA;"
                          FontSize="26"
                          Foreground="{ThemeResource TokenInkSecondaryBrush}" />
            </Grid>
            <TextBlock x:Name="EmptyTitle"
                       Text="No saved contacts"
                       Style="{StaticResource TokenTypeTitleSheetStyle}"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TokenInkBrush}" />
            <Button x:Name="AddContactBtn"
                    Content="Add a contact"
                    Style="{StaticResource GlassPrimaryButtonStyle}"
                    HorizontalAlignment="Center"
                    Click="AddContact_Click" />
        </StackPanel>
    </Grid>
</Page>
