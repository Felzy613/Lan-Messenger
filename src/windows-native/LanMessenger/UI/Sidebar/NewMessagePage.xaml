<Page
    x:Class="LanMessenger.UI.Sidebar.NewMessagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="0" MinWidth="360" MinHeight="420">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search bar — same pill style as ContactsPage, so the two sheets
             match exactly. -->
        <Border Grid.Row="0"
                Padding="12,10,12,6">
            <Grid ColumnSpacing="8"
                  Padding="10,6"
                  Background="{ThemeResource ControlFillColorDefaultBrush}"
                  CornerRadius="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE721;"
                          FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         PlaceholderText="Search contacts"
                         BorderThickness="0"
                         Background="Transparent"
                         TextChanged="SearchBox_TextChanged">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused"     Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused"      Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver"  Color="Transparent"/>
                    </TextBox.Resources>
                </TextBox>
                <Button x:Name="ClearSearchBtn"
                        Grid.Column="2"
                        Width="24" Height="24"
                        Padding="0"
                        CornerRadius="12"
                        BorderThickness="0"
                        Background="Transparent"
                        Visibility="Collapsed"
                        Click="ClearSearch_Click">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xE711;"
                              FontSize="10"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- Contact list -->
        <ListView x:Name="ContactsList"
                  Grid.Row="1"
                  SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding"                    Value="0" />
                    <Setter Property="MinHeight"                  Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Empty state: no saved contacts, or no search matches -->
        <StackPanel x:Name="EmptyState"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="Collapsed">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      Glyph="&#xE8FA;"
                      FontSize="40"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="EmptyTitle"
                       Text="No saved contacts"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="AddContactBtn"
                    Content="Add a contact"
                    Style="{StaticResource GlassPrimaryButtonStyle}"
                    HorizontalAlignment="Center"
                    Click="AddContact_Click" />
        </StackPanel>
    </Grid>
</Page>
