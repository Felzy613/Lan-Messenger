<UserControl
    x:Class="LanMessenger.UI.Sidebar.ConversationRowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:LanMessenger.UI">

    <!-- The options button lives under the time, where the unread badge
         goes, and shows while the pointer is over the row (or the button has
         focus, or its menu is open). As a fourth column it took 42px from the
         name and preview on every row, which is what left "Dovi's Compu…" and
         a paperclip alone on its own line in a 296px sidebar. The same menu
         is the row's right-click menu (set in the code-behind), which is also
         how touch reaches it. -->
    <Grid x:Name="RowRoot"
          Padding="4,6"
          ColumnSpacing="10"
          Height="{StaticResource TokenSizeRow}"
          Background="Transparent"
          PointerEntered="RowRoot_PointerEntered"
          PointerExited="RowRoot_PointerExited"
          PointerCanceled="RowRoot_PointerExited">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Avatar with presence dot (always visible; colour set by code-behind) -->
        <Grid Grid.Column="0" VerticalAlignment="Center">
            <ui:AvatarControl x:Name="Avatar"
                              Width="{StaticResource TokenSizeAvatarRow}"
                              Height="{StaticResource TokenSizeAvatarRow}" />
            <Ellipse x:Name="OnlineDot"
                     Width="{StaticResource TokenSizePresence}"
                     Height="{StaticResource TokenSizePresence}"
                     Stroke="{ThemeResource TokenPresenceRingBrush}" StrokeThickness="2"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>

        <!-- Name + preview -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="NameText"
                       Style="{StaticResource TokenTypeNameStyle}"
                       Foreground="{ThemeResource TokenInkBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PreviewText"
                       Style="{StaticResource TokenTypePreviewStyle}"
                       Foreground="{ThemeResource TokenInkSecondaryBrush}"
                       TextWrapping="Wrap"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis" />
            <!-- Takes the preview line's place while the peer is typing: the
                 thread's typing dots, smaller, in accent-ink on an accent-wash
                 capsule. Dot size and colour are set in the code-behind. -->
            <Border x:Name="TypingCapsule"
                    Background="{ThemeResource TokenAccentWashBrush}"
                    CornerRadius="10"
                    Padding="8,5"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed">
                <ui:TypingIndicatorControl x:Name="TypingDots" />
            </Border>
        </StackPanel>

        <!-- Timestamp, then the unread badge or (on hover) the options button -->
        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="TimestampText"
                       Style="{StaticResource TokenTypeCaptionStyle}"
                       HorizontalAlignment="Right" />
            <Grid Height="{StaticResource TokenSizeIconButton}" HorizontalAlignment="Right">
                <!-- brand with on-brand numerals: white on the green is 2:1. -->
                <Border x:Name="UnreadBadge"
                        Background="{ThemeResource TokenBrandBrush}"
                        CornerRadius="10"
                        MinWidth="20" Height="20"
                        Padding="6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="UnreadCount"
                               Style="{StaticResource TokenTypeBadgeStyle}"
                               Foreground="{ThemeResource TokenOnBrandBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Draws at 22px (the glyph) inside a 32px hit area. -->
                <Button x:Name="OptionsBtn"
                        Style="{StaticResource GlassIconButtonStyle}"
                        HorizontalAlignment="Right"
                        Margin="0,0,-6,0"
                        Opacity="0"
                        Click="OptionsBtn_Click"
                        GotFocus="OptionsBtn_FocusChanged"
                        LostFocus="OptionsBtn_FocusChanged"
                        ToolTipService.ToolTip="Conversation options"
                        AutomationProperties.Name="Conversation options">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xE712;"
                              FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="OptionsFlyout"
                                    Opened="OptionsFlyout_OpenedOrClosed"
                                    Closed="OptionsFlyout_OpenedOrClosed">
                            <MenuFlyoutItem x:Name="ArchiveItem" Text="Archive" Click="Archive_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7B8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="UnarchiveItem" Text="Unarchive" Click="Unarchive_Click" Visibility="Collapsed">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE74A;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Delete conversation" Click="Delete_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
