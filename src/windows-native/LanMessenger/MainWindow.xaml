<Window
    x:Class="LanMessenger.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sidebar="using:LanMessenger.UI.Sidebar"
    xmlns:tb="using:H.NotifyIcon">

    <!-- Row 0 is the title bar, drawn by the app on the same Mica as the
         rest of the window (ExtendsContentIntoTitleBar in the code-behind).
         Left to the system, the title bar takes the user's accent colour when
         "Show accent colour on title bars" is on: a band of magenta, red or
         whatever the user picked across the top of a green-and-glass app. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The drag region. Nothing interactive goes in here: the whole
             element becomes caption area and would swallow the clicks. The
             system's caption buttons draw over its right-hand end. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <Image Source="Assets/icon.ico"
                       Width="16" Height="16"
                       VerticalAlignment="Center" />
                <TextBlock x:Name="AppTitleText"
                           Text="LAN Messenger"
                           VerticalAlignment="Center"
                           Style="{StaticResource TokenTypeCaptionStyle}"
                           Foreground="{ThemeResource TokenInkSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="296" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: one pane of glass floating on the Mica backdrop, inset 8px
                 from the window. It takes the translucent SOLID glass-regular
                 brush, not acrylic: Mica is already the blur, and nothing in this
                 window scrolls under the panel. The column is 296 so the list
                 inside keeps the 280 it had before the inset. -->
            <ContentControl Grid.Column="0"
                            Style="{StaticResource GlassSurfaceStyle}"
                            Background="{ThemeResource TokenGlassRegularBrush}"
                            Margin="8,0,0,8"
                            CornerRadius="{StaticResource TokenRadiusPanel}"
                            Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Title on the left, toolbar group on the right — matches macOS toolbar placement -->
                    <Grid Grid.Row="0" Padding="8,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Chats"
                                   Style="{StaticResource TokenTypeTitlePaneStyle}"
                                   Foreground="{ThemeResource TokenInkBrush}"
                                   VerticalAlignment="Center" />

                        <!-- A flat glass capsule: clear fill and the rim, no float,
                             because it sits inside the panel's own glass. -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource TokenGlassClearBrush}"
                                BorderBrush="{ThemeResource GlassRimBrush}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="3">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="NewMessageBtn"
                                        Style="{StaticResource GlassIconButtonStyle}"
                                        ToolTipService.ToolTip="New message"
                                        AutomationProperties.Name="New message"
                                        Click="NewMessageBtn_Click">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              Glyph="&#xE932;"
                                              FontSize="16" />
                                </Button>
                                <Button x:Name="ContactsBtn"
                                        Style="{StaticResource GlassIconButtonStyle}"
                                        ToolTipService.ToolTip="Contacts"
                                        AutomationProperties.Name="Contacts"
                                        Click="ContactsBtn_Click">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              Glyph="&#xE77B;"
                                              FontSize="16" />
                                </Button>
                                <Button x:Name="SettingsBtn"
                                        Style="{StaticResource GlassIconButtonStyle}"
                                        ToolTipService.ToolTip="Settings"
                                        AutomationProperties.Name="Settings"
                                        Click="SettingsBtn_Click">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              Glyph="&#xE713;"
                                              FontSize="16" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <sidebar:SidebarControl x:Name="Sidebar"
                                            Grid.Row="1" />
                </Grid>
            </ContentControl>

            <!-- Placeholder shown until a conversation is opened. It sits under the
                 ContentControl, and the code-behind collapses it while a page is
                 showing: the Archived page is glass, so it would show through.
                 The EmptyState recipe: a clear-glass disc, a pane title, one line. -->
            <StackPanel x:Name="NoConversationState"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <Grid Width="64" Height="64" HorizontalAlignment="Center">
                    <Ellipse Fill="{ThemeResource TokenGlassClearBrush}"
                             Stroke="{ThemeResource GlassRimBrush}"
                             StrokeThickness="1" />
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xE8BD;"
                              FontSize="26"
                              Foreground="{ThemeResource TokenInkSecondaryBrush}" />
                </Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="LAN Messenger"
                               HorizontalAlignment="Center"
                               Style="{StaticResource TokenTypeTitlePaneStyle}"
                               Foreground="{ThemeResource TokenInkBrush}" />
                    <TextBlock Text="Select a conversation, or start a new one with the pencil button."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="240"
                               TextWrapping="Wrap"
                               Style="{StaticResource TokenTypeLabelStyle}"
                               Foreground="{ThemeResource TokenInkSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Content area -->
            <ContentControl x:Name="ContentFrame"
                            Grid.Column="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />

            <!-- System tray icon (lives off-screen but is rendered in the notification area) -->
            <tb:TaskbarIcon x:Name="TrayIcon"
                            ToolTipText="LAN Messenger"
                            NoLeftClickDelay="True"
                            IconSource="Assets/icon.ico"
                            LeftClickCommand="{x:Bind ShowFromTrayCommand, Mode=OneWay}">
                <tb:TaskbarIcon.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Open LAN Messenger"
                                        Command="{x:Bind OpenFromTrayCommand, Mode=OneWay}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Quit"
                                        Command="{x:Bind QuitFromTrayCommand, Mode=OneWay}" />
                    </MenuFlyout>
                </tb:TaskbarIcon.ContextFlyout>
            </tb:TaskbarIcon>
        </Grid>
    </Grid>
</Window>
